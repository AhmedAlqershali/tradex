modules = ["php-8.2", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_URL = "https://029f1b68-742d-4031-99a8-6422b7abd418-00-24s4za3y3xt7w.pike.replit.dev"
DB_DATABASE = "/home/runner/workspace/tradex-backend/database/database.sqlite"
FILESYSTEM_DISK = "public"
MAIL_MAILER = "log"
APP_DEBUG = "true"
APP_ENV = "local"
APP_FAKER_LOCALE = "en_US"
APP_FALLBACK_LOCALE = "en"
APP_LOCALE = "en"
APP_MAINTENANCE_DRIVER = "file"
APP_NAME = "TradexAPI"
BCRYPT_ROUNDS = "12"
BROADCAST_CONNECTION = "log"
CACHE_STORE = "file"
CORS_ALLOWED_ORIGINS = "*"
DB_CONNECTION = "sqlite"
LOG_CHANNEL = "daily"
LOG_DEPRECATIONS_CHANNEL = "null"
LOG_LEVEL = "debug"
LOG_STACK = "single"
QUEUE_CONNECTION = "database"
SANCTUM_EXPIRATION_MINUTES = "129600"
SESSION_DRIVER = "file"
SESSION_ENCRYPT = "false"
SESSION_LIFETIME = "120"
SESSION_PATH = "/"
AI_PROVIDER = "gemini"
DB_FOREIGN_KEYS = "true"
GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL = "gemini-2.0-flash"
MAIL_FROM_ADDRESS = "noreply@tradx.app"
MAIL_FROM_NAME = "TradexAPI"
MAIL_HOST = "127.0.0.1"
MAIL_PORT = "2525"
MAIL_SCHEME = "null"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
OPENROUTER_MODEL = "openrouter/free"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd tradex-backend && export DB_CONNECTION=sqlite DB_DATABASE=/home/runner/workspace/tradex-backend/database/database.sqlite CACHE_STORE=file SESSION_DRIVER=file MAIL_MAILER=log APP_ENV=local APP_DEBUG=true APP_KEY=\"base64:$(printf '%s' \"$SESSION_SECRET\" | sha256sum | cut -d' ' -f1 | xxd -r -p | base64 -w0)\" && php artisan config:clear && php -S 0.0.0.0:5000 -t public public/index.php"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd tradex-backend && php artisan config:cache && php artisan route:cache && php artisan view:cache && php artisan storage:link && exec php -S 0.0.0.0:5000 -t public public/index.php"]
build = ["bash", "-c", "cd tradex-backend && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader"]
