# SECURITY: never commit a real .env file (it already is gitignored —
# keep it that way, and never include it in a delivered/exported archive).
# APP_DEBUG must be `false` for any environment other than local
# development — leaving it `true` in staging/production leaks stack
# traces and config values to API clients on uncaught errors.
APP_NAME=TradxAPI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -------------------------------------------------------
# Database — MySQL
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradx
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# 'public' is required so uploaded product images and store logos are served
# via the public storage symlink. Run `php artisan storage:link` after deploy.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# -------------------------------------------------------
# CORS — restrict to your actual frontend origin(s).
# NEVER use * in production.
# Example: https://app.yourflutterdomain.com
# -------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# -------------------------------------------------------
# Sanctum token expiration (minutes). Default: 7 days.
# Use shorter values in production for tighter security.
# -------------------------------------------------------
SANCTUM_EXPIRATION_MINUTES=10080

# -------------------------------------------------------
# AI Provider — Google Gemini (default)
# Obtain your key at: https://aistudio.google.com/app/apikey
# Free tier is available for development/testing.
# -------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# -------------------------------------------------------
# Google Sign-In — OAuth web/client ID used to verify ID tokens
# -------------------------------------------------------
GOOGLE_CLIENT_ID=

# -------------------------------------------------------
# Firebase Cloud Messaging — server-to-device push delivery
# FIREBASE_CREDENTIALS must point to a server-side service-account JSON file
# supplied through deployment secrets or mounted secure storage. Never commit it.
# -------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# -------------------------------------------------------
# AI provider selection
# Keep Gemini as the default. Set AI_PROVIDER=openrouter only for a
# temporary live verification using OpenRouter's free router.
# -------------------------------------------------------
AI_PROVIDER=gemini

# -------------------------------------------------------
# AI Provider — OpenRouter (free router for live verification)
# Store OPENROUTER_API_KEY in Replit Secrets, never in this file.
# -------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -------------------------------------------------------
# AI Provider — OpenAI (retained for fallback / reference)
# -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -------------------------------------------------------
# Mail — change to smtp/ses/mailgun for production.
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@tradx.app"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------
# Queue — use "database" or "redis" in production.
# "sync" is for local development only.
# -------------------------------------------------------
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=

# -------------------------------------------------------
# Cache — use "redis" or "memcached" in production.
# -------------------------------------------------------
CACHE_STORE=database

# -------------------------------------------------------
# Logging — use "daily" in production, LOG_LEVEL=warning
# -------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning
